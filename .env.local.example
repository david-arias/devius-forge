# Supabase (Deméter/Eleuthia/Éter, Iteración 12 — preparación de backend).
# Copiar este archivo a .env.local (gitignored) y completar con las
# credenciales reales del proyecto creado en https://supabase.com.
#
# Ver src/lib/supabase/client.ts para la inicialización y
# src/lib/supabase/schema.ts para el DDL de la tabla `quests` y el bucket
# `quest-images` que hay que correr en el SQL Editor de Supabase.
#
# Iteración 28: SIN prefijo NEXT_PUBLIC_. El servidor las lee y se las
# pasa al navegador en runtime (src/components/eter/SupabaseRuntimeConfig.tsx),
# así en Vercel se guardan como variables privadas y no aparece el aviso
# "Remove the public framework prefix...". Los nombres viejos
# (NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY) se siguen
# aceptando como fallback.
#
# La `anon key` igual llega al navegador (login del CMS, subida de
# imágenes, telemetría): está pensada para eso mientras las tablas tengan
# RLS. NUNCA poner acá una SUPABASE_SERVICE_ROLE_KEY — esa key bypassea
# RLS y este proyecto no la necesita en ningún punto.

SUPABASE_URL=https://wrtyphhobkteachfkxgh.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndydHlwaGhvYmt0ZWFjaGZreGdoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk0OTk4MTYsImV4cCI6MjEwNTA3NTgxNn0.IwWxkGDwGGSa-Tg8QXXvgfkf7OeYUSCi5TryvNdcpUY

# Nota (Eleuthia/Éter, Iteración 14 — "La Forja Oculta"): el panel /admin
# usa @supabase/ssr (src/lib/supabase/server.ts + src/middleware.ts) para
# Auth con cookies server-side. NO hace falta ninguna variable nueva: usa
# exactamente las mismas dos de arriba (la anon key alcanza para
# email/password auth vía RLS). NUNCA agregar una SUPABASE_SERVICE_ROLE_KEY
# para este flujo.


# Draft Mode (APOLO, Iteración 18 — "El Puente Bifröst").
# OPCIONAL: si se define, `app/api/draft/route.ts` exige que el query
# param `?secret=` coincida antes de activar el Draft Mode.
#
# Iteración 27: el botón "Ver Preview" del CMS ya NO usa ningún secreto —
# `/api/draft` autoriza por la sesión de admin (cookie de Supabase). Este
# secreto queda sólo como segunda llave para abrir un preview SIN sesión
# (celular, compartirlo con un cliente): /api/draft?secret=…&slug=…
# Es server-only: NO existe más `NEXT_PUBLIC_DRAFT_MODE_SECRET`.
# Generar un valor random largo, ej.:
#   openssl rand -hex 32
DRAFT_MODE_SECRET=DeviusForge_8f7a6b5c4e3d2f10987654321

# ── Audio UI (Iteración 21) ─────────────────────────────────────────
# Apagado por defecto: sin los .mp3 reales en public/sfx/ cada sonido era un 404.
# Activar sólo cuando existan (o tras correr scripts/generate-silent-sfx.sh).
# NEXT_PUBLIC_SFX_ENABLED=true

# ── Dominio público (Iteración 23, renombrada en la 27) ─────────────
# Sin barra final. Alimenta metadata, JSON-LD, sitemap.xml y robots.txt.
# Server-only (sin prefijo NEXT_PUBLIC_): sólo la leen Server Components.
# `NEXT_PUBLIC_SITE_URL` se sigue aceptando como fallback heredado.
SITE_URL=https://devius.dev

# ── Telemetría propia (Iteración 25) ────────────────────────────────
# Los eventos se guardan en Supabase sólo en producción. Poner true para probar en `next dev`.
# NEXT_PUBLIC_TELEMETRY_DEV=true
