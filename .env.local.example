# Supabase (Deméter/Eleuthia/Éter, Iteración 12 — preparación de backend).
# Copiar este archivo a .env.local (gitignored) y completar con las
# credenciales reales del proyecto creado en https://supabase.com.
#
# Ver src/lib/supabase/client.ts para la inicialización y
# src/lib/supabase/schema.ts para el DDL de la tabla `quests` y el bucket
# `quest-images` que hay que correr en el SQL Editor de Supabase.
#
# NEXT_PUBLIC_* es seguro de exponer en el bundle del cliente: es la
# `anon key`, pensada para eso siempre que la tabla tenga RLS habilitado
# (ya viene en el DDL de schema.ts). NUNCA agregar acá una
# SUPABASE_SERVICE_ROLE_KEY — esa key bypassea RLS y sólo debe vivir en
# código server-only, nunca en una variable NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://wrtyphhobkteachfkxgh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndydHlwaGhvYmt0ZWFjaGZreGdoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk0OTk4MTYsImV4cCI6MjEwNTA3NTgxNn0.IwWxkGDwGGSa-Tg8QXXvgfkf7OeYUSCi5TryvNdcpUY

# Nota (Eleuthia/Éter, Iteración 14 — "La Forja Oculta"): el panel /admin
# usa @supabase/ssr (src/lib/supabase/server.ts + src/middleware.ts) para
# Auth con cookies server-side. NO hace falta ninguna variable nueva: usa
# exactamente las mismas dos de arriba (la anon key alcanza para
# email/password auth vía RLS). NUNCA agregar una SUPABASE_SERVICE_ROLE_KEY
# para este flujo.


# Draft Mode (APOLO, Iteración 18 — "El Puente Bifröst").
# OPCIONAL: si se define, `app/api/draft/route.ts` exige que el query
# param `?secret=` coincida exactamente antes de activar el Draft Mode —
# sin esta env var, ese endpoint queda abierto (ver el docblock del
# propio route.ts sobre por qué eso es un riesgo aceptable acá: lo único
# que "filtra" es contenido en borrador de un portafolio de un solo
# admin, nunca credenciales ni datos de otra persona).
#
# Si se define DRAFT_MODE_SECRET (server-only), definir TAMBIÉN
# NEXT_PUBLIC_DRAFT_MODE_SECRET con el mismo valor — el botón "Ver
# Preview" del CMS (`PreviewLink.tsx`, Client Component) lo necesita para
# mandarlo como query param. Generar un valor random largo, ej.:
#   openssl rand -hex 32
DRAFT_MODE_SECRET=DeviusForge_8f7a6b5c4e3d2f10987654321
NEXT_PUBLIC_DRAFT_MODE_SECRET=DeviusForge_8f7a6b5c4e3d2f10987654321

# ── Audio UI (Iteración 21) ─────────────────────────────────────────
# Apagado por defecto: sin los .mp3 reales en public/sfx/ cada sonido era un 404.
# Activar sólo cuando existan (o tras correr scripts/generate-silent-sfx.sh).
# NEXT_PUBLIC_SFX_ENABLED=true

# ── Dominio público (Iteración 23) ──────────────────────────────────
# Sin barra final. Alimenta metadata, JSON-LD, sitemap.xml y robots.txt.
NEXT_PUBLIC_SITE_URL=https://devius.dev

# ── Telemetría propia (Iteración 25) ────────────────────────────────
# Los eventos se guardan en Supabase sólo en producción. Poner true para probar en `next dev`.
# NEXT_PUBLIC_TELEMETRY_DEV=true
